# Local development. Production must use your exact HTTPS origin, no trailing slash.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_PATH=./data/zaman.sqlite
# Set to 1 ONLY behind the supplied local Nginx proxy; keep the Node port private.
TRUST_PROXY=0
# Configure all three to enable online payments. Never put these in browser JS.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
